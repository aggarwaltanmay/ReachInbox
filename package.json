{
  "name": "reachinbox-email-scheduler",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @reachinbox/api\" \"npm run dev -w @reachinbox/web\"",
    "build": "npm run build -w @reachinbox/api && npm run build -w @reachinbox/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
